# Copy to .env.local and fill in from Firebase console:
# Project settings -> General -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your own Firebase Auth UID (shown in Authentication -> Users after you sign up).
# Must match the adminUid() constant in firestore.rules.
VITE_ADMIN_UID=

# Set to "true" for local development against the Firebase emulators.
VITE_USE_EMULATORS=false

# Admin email notification when a new instructor registers, sent via Web3Forms
# (https://web3forms.com) directly from the browser — no server needed on the
# Spark plan. Create a free access key tied to the admin's email; the email
# goes to whoever owns the key. Leave blank to disable. This key is write-only
# (it can only email the key owner, not read data or mail others), so it's safe
# to ship in the client bundle; rotate it in the dashboard if ever abused.
VITE_WEB3FORMS_ACCESS_KEY=
