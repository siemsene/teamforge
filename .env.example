# Copy to .env.local and fill in from Firebase console:
# Project settings -> General -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your own Firebase Auth UID (shown in Authentication -> Users after you sign up).
# Must match the adminUid() constant in firestore.rules.
VITE_ADMIN_UID=

# Set to "true" for local development against the Firebase emulators.
VITE_USE_EMULATORS=false
