rules_version = '2';

// Access model:
//  - Admin (hardcoded UID below) approves instructor accounts.
//  - Approved instructors own sessions and everything beneath them.
//  - Students sign in anonymously and act on exactly one document whose id is
//    the SHA-256 hash of their login code. Possession of the code is the
//    capability; 'list' is never granted, so codes cannot be enumerated.
//  - Student responses are client-side encrypted, so even readable documents
//    expose no survey content.

service cloud.firestore {
  match /databases/{database}/documents {

    // *** Replace with your own Firebase Auth UID after first sign-in. ***
    function adminUid() {
      return "vuwpd2TlrhVhqCJDECfaZUPq2Rw2";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == adminUid();
    }

    function isApprovedInstructor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function ownsSession(sid) {
      return isSignedIn()
        && get(/databases/$(database)/documents/sessions/$(sid)).data.ownerUid == request.auth.uid;
    }

    function sessionIsOpen(sid) {
      return get(/databases/$(database)/documents/sessions/$(sid)).data.status == "open";
    }

    function isJwkPublicKey(value) {
      return value is map
        && value.keys().hasAll(["kty", "crv", "x", "y"])
        && value.keys().hasOnly(["kty", "crv", "key_ops", "ext", "x", "y"])
        && value.kty is string
        && value.crv is string
        && value.x is string
        && value.y is string;
    }

    function isEciesPayload(value) {
      return value == null
        || (value is map
            && value.keys().hasAll(["ephemeralPublicKeyJwk", "iv", "ciphertext"])
            && value.keys().hasOnly(["ephemeralPublicKeyJwk", "iv", "ciphertext"])
            && isJwkPublicKey(value.ephemeralPublicKeyJwk)
            && value.iv is string
            && value.ciphertext is string);
    }

    function isValidStudentResponseUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["response", "submittedAt"])
        && isEciesPayload(request.resource.data.response)
        && (request.resource.data.submittedAt == null || request.resource.data.submittedAt is number);
    }

    // ---------- team management (optional post-allocation phase) ----------

    function teamMgmtOn(sid) {
      let s = get(/databases/$(database)/documents/sessions/$(sid)).data;
      return ("teamMgmt" in s) && s.teamMgmt.enabled == true;
    }

    // Peer-eval rounds have their own open/closed status, independent of the
    // session status (evals happen after the session is "closed").
    function roundOpen(sid, round) {
      let s = get(/databases/$(database)/documents/sessions/$(sid)).data;
      return ("teamMgmt" in s) && s.teamMgmt.rounds[round].status == "open";
    }

    function isAesEnvelope(value) {
      return value == null
        || (value is map
            && value.keys().hasAll(["iv", "ciphertext"])
            && value.keys().hasOnly(["iv", "ciphertext"])
            && value.iv is string
            && value.ciphertext is string);
    }

    function isPeerEvalSubmission(value) {
      return value == null
        || (value is map
            && value.keys().hasAll(["submittedAt", "payload"])
            && value.keys().hasOnly(["submittedAt", "payload"])
            && value.submittedAt is number
            && isEciesPayload(value.payload));
    }

    // A student may write exactly one round's submission, only while that round
    // is open. roster/result*/codeIndex stay owner-only.
    function isValidPeerEvalUpdate(sid) {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return (keys.hasOnly(["peerEvalFormative"])
              && roundOpen(sid, "formative")
              && isPeerEvalSubmission(request.resource.data.peerEvalFormative))
          || (keys.hasOnly(["peerEvalSummative"])
              && roundOpen(sid, "summative")
              && isPeerEvalSubmission(request.resource.data.peerEvalSummative));
    }

    // Team members may update only the contract field, with the expected shape.
    // teamLabel/createdAt are owner-only, so students cannot rename teams.
    function isValidContractUpdate() {
      let c = request.resource.data.contract;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["contract"])
        && c is map
        && c.keys().hasAll(["status", "updatedAt", "updatedByCodeIndex", "content",
                            "contentForInstructor", "feedback", "feedbackAt", "finalizedAt"])
        && c.keys().hasOnly(["status", "updatedAt", "updatedByCodeIndex", "content",
                             "contentForInstructor", "feedback", "feedbackAt", "finalizedAt"])
        && c.status in ["empty", "draft", "final"]
        && c.updatedAt is number
        && (c.updatedByCodeIndex == null || c.updatedByCodeIndex is number)
        && isAesEnvelope(c.content)
        && isAesEnvelope(c.feedback)
        && isEciesPayload(c.contentForInstructor)
        && (c.feedbackAt == null || c.feedbackAt is number)
        && (c.finalizedAt == null || c.finalizedAt is number);
    }

    // A student writing their own display name touches exactly one key of the
    // nicknames map. We cannot verify *which* member is writing — holding the
    // team token is the capability, same as for the shared contract — but
    // one-key-at-a-time stops a single write from rewriting the whole team's
    // names, and the cap bounds growth. Values stay opaque ciphertext; a
    // garbage entry only fails to decrypt and falls back to the code index.
    function isValidNicknameUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nicknames"])
        && ("nicknames" in resource.data)
        && request.resource.data.nicknames is map
        && request.resource.data.nicknames.size() <= 60
        && request.resource.data.nicknames
             .diff(resource.data.nicknames)
             .affectedKeys().size() == 1;
    }

    match /users/{uid} {
      // Self-registration always starts unapproved.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.approved == false;
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      // Admin can change anything (e.g. the approved flag). A user may only edit
      // their own profile fields — never approved/email/createdAt — so the
      // whitelist also keeps the approved flag out of a self-update.
      allow update: if isAdmin()
        || (isSignedIn()
            && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "university", "usage"]));
      allow delete: if isAdmin();
    }

    match /sessions/{sid} {
      allow create: if isApprovedInstructor()
        && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Survey config students need: questions, project blurbs, public key.
      match /public/{docId} {
        allow get: if isSignedIn();
        allow write: if ownsSession(sid);
      }

      match /projects/{pid} {
        allow read, write: if ownsSession(sid);
      }

      match /students/{codeHash} {
        // get-not-list: a valid code (hence hash) is required to touch a doc.
        allow get: if isSignedIn();
        allow list, create, delete: if ownsSession(sid);
        // Students may only write their encrypted response while the survey is
        // open (or a peer-eval submission while that round is open), and may
        // not touch codeIndex.
        allow update: if ownsSession(sid)
          || (isSignedIn()
              && sessionIsOpen(sid)
              && isValidStudentResponseUpdate())
          || (isSignedIn() && isValidPeerEvalUpdate(sid));
      }

      // Team contract docs. Doc id = SHA-256 of an unguessable team token that
      // is distributed only inside each member's encrypted roster blob —
      // get-not-list, mirroring the login-code capability model.
      match /teams/{tokenHash} {
        allow get: if isSignedIn();
        allow list, create, delete: if ownsSession(sid);
        allow update: if ownsSession(sid)
          || (isSignedIn() && teamMgmtOn(sid) && isValidContractUpdate())
          || (isSignedIn() && teamMgmtOn(sid) && isValidNicknameUpdate());
      }

      match /results/{docId} {
        allow read, write: if ownsSession(sid);
      }
    }
  }
}
