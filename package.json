{
  "name": "teamforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -p tsconfig.app.json --noEmit",
    "check": "npm run lint && npm test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "node scripts/generate-instructor-guide.mjs && node scripts/generate-student-guide.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-teamforge \"vitest run tests/rules.test.ts tests/nicknameFlow.test.ts\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "firebase": "^12.14.0",
    "highs": "^1.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "^15.20.0",
    "pdfkit": "^0.19.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
